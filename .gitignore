# Java
*.class
*.jar
*.war
*.ear

# Gradle wrapper bootstrap JAR must be committed so a fresh clone can run
# ./gradlew without a preinstalled Gradle. Re-included from the *.jar rule above.
!gradle/wrapper/gradle-wrapper.jar
!**/gradle/wrapper/gradle-wrapper.jar

# Maven
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next

# Gradle (如果用的话)
.gradle/
build/

# IDE
.idea/
*.iml
*.iws
*.ipr
.vscode/
*.swp

# Spring Boot
*.log
logs/

# 敏感文件
config/rsa.pub
config/rsa.pri
application-local.yml
application-prod.yml
*.pem
*.tfvars
*.tfvars.json
config/rsa-private.pem
config/rsa-public.pem

# OS
.DS_Store
Thumbs.db

# Docker (保留 Dockerfile，忽略其他)
docker-compose.override.yml

# Terraform
.terraform/
*.tfstate
*.tfstate.backup
.terraform.lock.hcl

